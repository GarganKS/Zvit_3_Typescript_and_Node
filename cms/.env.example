# Підключення до PostgreSQL ( Neon, Supabase, локальний docker — будь-що )
DATABASE_URL=postgresql://user:password@localhost:5432/your-database-name

# Секрет для шифрування сесій Payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Публічні адреси ( локальна розробка )
FRONTEND_URL=http://localhost:5173
CMS_URL=http://localhost:3000

# Токен Vercel Blob Storage для зображень ( у Vercel → Storage → Blob )
BLOB_READ_WRITE_TOKEN=
