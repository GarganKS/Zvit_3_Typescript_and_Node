# Підключення до PostgreSQL ( Neon, Supabase, локальний docker — будь-що )
# Neon: pooled-адреса (хост з -pooler) — для Vercel
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require
# Neon: пряма адреса (без -pooler) — для локального dev та міграцій
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# Секрет для шифрування сесій Payload
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Публічні адреси ( локальна розробка )
FRONTEND_URL=http://localhost:5173
CMS_URL=http://localhost:3000

# Токен Vercel Blob Storage для зображень ( у Vercel → Storage → Blob )
BLOB_READ_WRITE_TOKEN=
